# Signing material must never be committed. `my-upload-key.jks` is the default
# release keystore path in app/build.gradle.kts.
*.jks
*.keystore
my-upload-key.jks
.git-commit-msg.txt
.git_commit_msg.txt
.tmp_frp/

# Scratch space agents/tools tend to drop into the repo root: an `undefined/` path
# appears whenever a shell variable that was meant to expand (a temp dir) is empty,
# and stray run logs land next to the checkout. Neither belongs in a commit.
/undefined/
*.tmp.log
/.tmp_*.log


/.codebuddy/
/.trae/

# Rust build output: the workspace compiles the core for four Android ABIs, so the target
# tree is tens of thousands of object files that belong to nobody's clone.
/rust/target/